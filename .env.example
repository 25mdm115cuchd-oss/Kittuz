# =========================================================================
# KITTUZ LUXURY LIFESTYLE E-COMMERCE PLATFORM - ENVIRONMENT VARIABLES
# =========================================================================

# GEMINI_API_KEY: Required for KITTUZ AI Shopping Stylist (Anya).
# Injected automatically in AI Studio; for standalone deployments, obtain from https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# RAZORPAY PAYMENT GATEWAY (Indian Rupee transactions)
# Obtain test/live API credentials from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"

# SUPABASE POSTGRESQL & AUTHENTICATION
# Obtain project credentials from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
